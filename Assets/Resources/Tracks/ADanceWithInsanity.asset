  - Time: 150
    Dialogue:
    - Text: '[s="gloria"][patterns="0"]Well, well, WELL! Somebody''s been paying
        attention!'
      Audio: {fileID: 0}
    - Text: '[s="you"]You''re not exactly subtle'
      Audio: {fileID: 0}
    - Text: '[s="gloria"]Subtlety is for people without an audience, darling!'
      Audio: {fileID: 0}
    - Text: '[s="you"]There''s an audience?'
      Audio: {fileID: 0}
    - Text: '[s="gloria"]Oh, don''t be so literal'
      Audio: {fileID: 0}
    - Text: "[s=\"gloria\"]\u2026It ruins the atmosphere"
      Audio: {fileID: 0}
    - Text: '[s="gloria"]Now, chin up! Shoulders back!'
      Audio: {fileID: 0}
    - Text: '[s="gloria"][patterns="1,2,3,4,5,6"]If we''re going to do this, we''re
        going to do it PROPERLY!'
