  Dialogue:
  - Time: 0
    Dialogue:
    - Text: '[s="gloria"][patterns="1,2,3,4,5,6"]A proper waltz! One must ALWAYS
        make time for a little elegance!'
      Audio: {fileID: 0}
    - Text: '[s="gloria"]Now, let''s see if you can manage a little three step...'
      Audio: {fileID: 0}
    - Text: '[s="you"]Oh, you have GOT TO BE KIDDING ME!'
      Audio: {fileID: 0}
    - Text: '[s="gloria"][auto="2"]A little faster, darling! We are not dancing the
        FUNERAL WALTZ! '
      Audio: {fileID: 0}
    - Text: '[s="gloria"][auto="1"]Come now! One, two, three! One, two, THREE! '
      Audio: {fileID: 0}
